@model QuizMaster.Models.ViewModel.Quiz.Student.StudentTakeQuizViewModel

@{
    ViewData["Title"] = "Take Quiz";
}

<div class="container mt-4">
    <h2>@Model.Title</h2>

    <form asp-action="Submit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="AttemptId" value="@Model.AttemptId" />

        @for (int i = 0; i < Model.Questions.Count(); i++)
        {
            var q = Model.Questions[i];

            <div class="card mb-3">
                <div class="card-body">
                    <p class="fw-bold">
                        @(i + 1). @q.Text
                        <span class="badge bg-secondary">@q.Points pts</span>
                    </p>

                    <input type="hidden"
                           name="Answers[@i].QuestionId"
                           value="@q.QuestionId" />

                    @if (q.Type == "MCQ")
                    {
                        foreach (var opt in q.AnswerOptions!)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="Answers[@i].SelectedOptionId"
                                       value="@opt.OptionId" />
                                <label class="form-check-label">
                                    @opt.Text
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <textarea class="form-control"
                                  name="Answers[@i].AnswerText"
                                  rows="3"></textarea>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-success">
            Submit Quiz
        </button>
    </form>
</div>