@model IEnumerable<QuizMaster.Models.ViewModel.Quiz.QuizListItemViewModel>

@{
    ViewData["Title"] = "My Quizzes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">My Quizzes</h2>
            <p class="text-muted mb-0">Manage your quizzes and track student progress</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Create Quiz
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                    <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h13zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-13z"/>
                    <path d="M5 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 5 8zm0-2.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0 5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-1-5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zM4 8a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zm0 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
                </svg>
            </div>
            <h5 class="text-muted">No quizzes yet</h5>
            <p class="text-muted">Create your first quiz to get started.</p>
            <a asp-action="Create" class="btn btn-primary">+ Create Quiz</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var quiz in Model)
            {
                var isExpired = quiz.ExpiresAt < DateTime.UtcNow;

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@quiz.Title</h5>
                                @if (isExpired)
                                {
                                    <span class="badge bg-danger">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </div>

                            <div class="text-muted small mt-2 mb-3">
                                <div>Created: @quiz.CreatedAt.ToString("MMM dd, yyyy")</div>
                                <div>Expires: @quiz.ExpiresAt.ToString("MMM dd, yyyy")</div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@quiz.Id"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    View Details
                                </a>
                                <a asp-controller="Question" asp-action="Create" asp-route-quizId="@quiz.Id"
                                   class="btn btn-outline-secondary btn-sm flex-fill">
                                    + Add Question
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
