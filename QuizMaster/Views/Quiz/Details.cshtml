@model QuizMaster.Models.ViewModel.Quiz.QuizDetailsViewModel

@{
    ViewData["Title"] = "Quiz Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@Model.Title</h2>

        <a asp-controller="Question"
           asp-action="Create"
           asp-route-quizId="@Model.Id"
           class="btn btn-primary">
            + Add Question
        </a>
    </div>

    @if (!Model.Questions.Any())
    {
        <div class="alert alert-warning">
            No questions have been added yet.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Question</th>
                        <th>Type</th>
                        <th>Points</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr>
                            <td>@q.Text</td>
                            <td>@q.Type</td>
                            <td>@q.Points</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to quizzes
        </a>
    </div>
</div>
